@model IEnumerable<JoinJoyWebapp.Models.TagsDto>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Tags List</title>
</head>
<body>
    <h1>Tags</h1>
    <table border="1">
        <thead>
            <tr>
                <th>Tag Name</th>
                <th>Category ID</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tag in Model)
            {
                <tr>
                    <td>@tag.Tag_name</td>
                    <td>@tag.Category_id</td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>