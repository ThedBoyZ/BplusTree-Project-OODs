@model IEnumerable<JoinJoyWebapp.Models.CategoriesDto>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Category List</title>
</head>
<body>
    <h1>Category</h1>
    <table border="1">
        <thead>
            <tr>
                <th>Category Name</th>
                <th>Category ID</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in Model)
            {
                <tr>
                    <td>@cat.Category_name</td>
                    <td>@cat.Id</td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>